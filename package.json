{
  "name": "planinc-monorepo",
  "version": "1.8.8",
  "private": true,
  "packageManager": "bun@1.2.8",
  "workspaces": [
    "frontend",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "cd frontend && bun run tauri dev",
    "build:web": "turbo run build:web",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "start:server:production": "ncp dist/public server/public && cd server && bun run start",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:backend": "turbo run dev --filter=@planinc/backend",
    "dev:frontend": "turbo run dev --filter=@planinc/frontend",
    "postinstall": "echo \"no codegen needed (SurrealDB schemaless)\"",
    "setup": "bun install",
    "build:planinc:types": "tsc -p tsconfig.planinc.json",
    "seed": "cd server && bun run seed.ts",
    "seed:planning-fixtures": "cd server && bun run scripts/seed-planning-fixtures.ts",
    "create:superuser": "cd server && bun --env-file=../.env scripts/create-superuser.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/lru-cache": "^7.10.10",
    "concurrently": "^9.1.2",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "turbo": "latest",
    "typescript": "^5.1.6",
    "vite-plugin-pwa": "^1.0.0",
    "workbox-window": "^7.3.0"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "lru-cache": "^11.1.0",
    "react-i18next": "^15.4.1",
    "react-simple-pull-to-refresh": "^1.3.3",
    "wait-on": "^8.0.3"
  }
}
