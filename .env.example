# PlanInc — environment variable reference
# Copy to .env and fill in real values. Never commit .env to version control.

# ─── Server ──────────────────────────────────────────────────────────────────
# HTTP port the PlanInc service listens on (default: 1111)
PLANINC_PORT=1111

# Public URL — used for share links and NEXTAUTH_URL
# In production set to https://notes.structa.cloud (the dedicated vhost defined
# in proxy/configs/traefik/dynamic/notes.yml).
PLANINC_PUBLIC_URL=http://localhost:1111

# Docker network the container joins.
#   Local deployment  → leave both unset; a project-scoped network is created.
#   Behind the proxy  → PLANINC_EXTERNAL_NETWORK=true (a boolean: attach to a
#                       network that already exists) and
#                       PLANINC_NETWORK_NAME=common, which selects it — Traefik
#                       then reaches the container as `planinc:1111`.
PLANINC_EXTERNAL_NETWORK=
PLANINC_NETWORK_NAME=

# JWT signing secret — change this before deploying
PLANINC_NEXTAUTH_SECRET=planinc-secret-change-me

# ─── Bootstrap superuser ────────────────────────────────────────────────────
# Created automatically on first boot (make deploy / make up / make run) when
# both are set. Idempotent: an existing account with that name is never
# modified. Password must be 8+ characters.
PLANINC_SUPERUSER_NAME=
PLANINC_SUPERUSER_PASSWORD=

# ─── SurrealDB (embedded file mode — no container required) ──────────────────
# Path to the SurrealDB embedded database file.
# Default: runtime/data/planinc.db (relative to the runtime/ directory)
# In Docker this is /app/data/planinc.db (mounted via the data volume).
PLANINC_DB_FILE=

# SurrealDB namespace and database names (rarely need changing)
PLANINC_DB_NS=planinc
PLANINC_DB_NAME=planinc

# ─── File uploads ─────────────────────────────────────────────────────────────
# Maximum upload size in bytes (default: 25 MB)
MAX_UPLOAD_BYTES=26214400

# ─── Chat context ─────────────────────────────────────────────────────────────
# Directory the AI chat can read as project context (mounted read-only)
PLANINC_CONTEXT_PROJECT_DIR=

# Maximum bytes of context files sent to the AI per request (default: 256 KB)
PLANINC_CONTEXT_MAX_BYTES=262144

# ─── Email sharing (Phase 4 — optional) ──────────────────────────────────────
# If SMTP_HOST is not set, email share invites log the URL instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@structa.cloud

# Comma-separated browser/Tauri origins allowed for credentialed API requests.
# Leave empty for same-origin browser requests only.
PLANINC_CORS_ORIGINS=
