# PlanInc — environment variable reference
# Copy to .env and fill in real values. Never commit .env to version control.

# ─── Server ──────────────────────────────────────────────────────────────────
# HTTP port the planing service listens on (default: 1111)
PLANING_PORT=1111

# Public URL — used for share links and NEXTAUTH_URL
# In production set to https://tools.structa.cloud/planing
PLANING_PUBLIC_URL=http://localhost:1111

# JWT signing secret — change this before deploying
PLANING_NEXTAUTH_SECRET=planing-secret-change-me

# ─── SurrealDB (embedded file mode — no container required) ──────────────────
# Path to the SurrealDB embedded database file.
# Default: runtime/data/planinc.db (relative to the runtime/ directory)
# In Docker this is /app/data/planinc.db (mounted via the data volume).
SURREALDB_FILE=

# SurrealDB namespace and database names (rarely need changing)
SURREALDB_NS=planinc
SURREALDB_DB=planinc

# ─── File uploads ─────────────────────────────────────────────────────────────
# Maximum upload size in bytes (default: 25 MB)
MAX_UPLOAD_BYTES=26214400

# ─── Chat context ─────────────────────────────────────────────────────────────
# Directory the AI chat can read as project context (mounted read-only)
PLANING_CONTEXT_PROJECT_DIR=

# Maximum bytes of context files sent to the AI per request (default: 256 KB)
PLANING_CONTEXT_MAX_BYTES=262144

# ─── Email sharing (Phase 4 — optional) ──────────────────────────────────────
# If SMTP_HOST is not set, email share invites log the URL instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@structa.cloud
