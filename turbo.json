{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [],
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "BACKEND_PORT",
    "FRONTEND_PORT",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "UPLOAD_PATH"
  ],
  "tasks": {
    "build:web": {
      "inputs": [
        ".env"
      ],
      "dependsOn": [
        "^build:web"
      ],
      "outputs": [
        "dist/**",
        "../dist/**"
      ]
    },
    "dev": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env"
      ],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": [
        "build:web"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "build:web"
      ]
    }
  }
}
